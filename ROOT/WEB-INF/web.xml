  <servlet-mapping><servlet-name>p_admin_export</servlet-name><url-pattern>/admin/export</url-pattern></servlet-mapping>

  <!-- 기존 사이트 호환 리다이렉트용 -->
  <servlet><servlet-name>p_legacy</servlet-name><jsp-file>/WEB-INF/views/legacy.jsp</jsp-file></servlet>
  <servlet-mapping><servlet-name>p_legacy</servlet-name><url-pattern>/about</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>p_legacy</servlet-name><url-pattern>/data/self</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>p_legacy</servlet-name><url-pattern>/community/ref/board</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>p_legacy</servlet-name><url-pattern>/community/center</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>p_legacy</servlet-name><url-pattern>/special/remote</url-pattern></servlet-mapping>

  <!-- 웹 루트에서 JSP 조각/데이터 디렉터리 직접 접근 차단 -->
  <security-constraint>
    <web-resource-collection>
      <web-resource-name>blocked</web-resource-name>
      <url-pattern>*.jspf</url-pattern>
    </web-resource-collection>
    <auth-constraint/>
  </security-constraint>
</web-app>
