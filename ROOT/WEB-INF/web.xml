<?xml version="1.0" encoding="UTF-8"?>
<!--
  (주)명정보기술 홈페이지 - Tomcat 7 (Servlet 3.0 / JSP 2.2)
  - 별도 빌드 없이 webapps/ROOT 에 그대로 배포합니다. (JSP 는 Tomcat 이 컴파일)
  - 기존 사이트 URL(/about/greeting 등)을 그대로 유지하기 위해 각 URL 을 JSP 파일에 매핑합니다.
  - 고객 문의 데이터는 ROOT 바깥 디렉터리에 저장됩니다. (README.md 참고)
-->
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0">

  <display-name>myung.co.kr</display-name>

  <!--
    문의 저장 디렉터리 (비워두면 기본값 사용)
    우선순위: JVM 옵션 -Dmyung.data.dir  >  환경변수 MYUNG_DATA_DIR  >  아래 값  >  ${catalina.base}/myung-data
    ※ ROOT(웹 루트) 내부 경로를 지정하면 저장이 거부됩니다.
  -->
  <context-param>
    <param-name>myung.data.dir</param-name>
    <param-value></param-value>
  </context-param>

  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
    </cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>

  <jsp-config>
    <jsp-property-group>
      <url-pattern>*.jsp</url-pattern>
      <url-pattern>*.jspf</url-pattern>
      <page-encoding>UTF-8</page-encoding>
      <trim-directive-whitespaces>true</trim-directive-whitespaces>
    </jsp-property-group>
  </jsp-config>

  <mime-mapping><extension>woff2</extension><mime-type>font/woff2</mime-type></mime-mapping>
  <mime-mapping><extension>json</extension><mime-type>application/json</mime-type></mime-mapping>
  <mime-mapping><extension>svg</extension><mime-type>image/svg+xml</mime-type></mime-mapping>

  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <error-page><error-code>404</error-code><location>/WEB-INF/views/error/404.jsp</location></error-page>
  <error-page><error-code>500</error-code><location>/WEB-INF/views/error/500.jsp</location></error-page>

  <!-- ===== 페이지 URL 매핑 ===== -->
  <servlet><servlet-name>p_about_greeting</servlet-name><jsp-file>/WEB-INF/views/about/greeting.jsp</jsp-file></servlet>
  <servlet-mapping><servlet-name>p_about_greeting</servlet-name><url-pattern>/about/greeting</url-pattern></servlet-mapping>
  <servlet><servlet-name>p_about_history</servlet-name><jsp-file>/WEB-INF/views/about/history.jsp</jsp-file></servlet>
  <servlet-mapping><servlet-name>p_about_history</servlet-name><url-pattern>/about/history</url-pattern></servlet-mapping>
  <servlet><servlet-name>p_about_awards</servlet-name><jsp-file>/WEB-INF/views/about/awards.jsp</jsp-file></servlet>
  <servlet-mapping><servlet-name>p_about_awards</servlet-name><url-pattern>/about/awards</url-pattern></servlet-mapping>
  <servlet><servlet-name>p_about_contact</servlet-name><jsp-file>/WEB-INF/views/about/contact.jsp</jsp-file></servlet>
  <servlet-mapping><servlet-name>p_about_contact</servlet-name><url-pattern>/about/contact</url-pattern></servlet-mapping>
