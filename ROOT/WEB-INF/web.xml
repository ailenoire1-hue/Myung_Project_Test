  <servlet-mapping><servlet-name>p_solution_mit_hash</servlet-name><url-pattern>/solution/mit_hash</url-pattern></servlet-mapping>
  <servlet><servlet-name>p_community_notice</servlet-name><jsp-file>/WEB-INF/views/community/notice.jsp</jsp-file></servlet>
  <servlet-mapping><servlet-name>p_community_notice</servlet-name><url-pattern>/community/notice</url-pattern></servlet-mapping>
  <servlet><servlet-name>p_community_notice_view</servlet-name><jsp-file>/WEB-INF/views/community/notice/view.jsp</jsp-file></servlet>
  <servlet-mapping><servlet-name>p_community_notice_view</servlet-name><url-pattern>/community/notice/view</url-pattern></servlet-mapping>
