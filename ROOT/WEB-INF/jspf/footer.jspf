<!-- 모바일 하단 빠른 메뉴 -->
<nav class="quickbar" aria-label="빠른 상담">
  <a href="tel:<%= CS_TEL %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>전화 상담</a>
  <a href="<%= KAKAO_URL %>" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3C6.5 3 2 6.6 2 11c0 2.8 1.9 5.3 4.7 6.7l-1 3.6c-.1.3.3.6.6.4l4.2-2.8c.5.1 1 .1 1.5.1 5.5 0 10-3.6 10-8S17.5 3 12 3z"/></svg>카카오톡</a>
  <button type="button" data-open-modal="callModal"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm0 2v.5l8 5 8-5V6H4zm16 2.8-8 5-8-5V18h16V8.8z"/></svg>상담 요청</button>
  <a href="/data/request" class="is-primary"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 7V3.5L18.5 9H13zM8 13h8v2H8v-2zm0 4h8v2H8v-2z"/></svg>복구 접수</a>
</nav>

<!-- 우측 플로팅 (PC) -->
<div class="floating" aria-label="빠른 상담">
  <a class="floating-kakao" href="<%= KAKAO_URL %>" target="_blank" rel="noopener" title="카카오톡 상담">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3C6.5 3 2 6.6 2 11c0 2.8 1.9 5.3 4.7 6.7l-1 3.6c-.1.3.3.6.6.4l4.2-2.8c.5.1 1 .1 1.5.1 5.5 0 10-3.6 10-8S17.5 3 12 3z"/></svg><span>카톡상담</span>
  </a>
  <button type="button" class="floating-call" data-open-modal="callModal" title="상담 요청">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg><span>상담요청</span>
  </button>
  <button type="button" class="floating-top" id="toTop" title="맨 위로" aria-label="맨 위로">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7l-7 7 1.4 1.4L12 9.8l5.6 5.6L19 14z"/></svg>
  </button>
</div>

<!-- 상담 요청 모달 -->
<div class="modal" id="callModal" role="dialog" aria-modal="true" aria-labelledby="callModalTitle" hidden>
  <div class="modal-dialog">
    <button type="button" class="modal-close" data-close-modal aria-label="닫기">&times;</button>
    <h2 class="modal-title" id="callModalTitle">빠른 상담 요청</h2>
    <p class="modal-desc">연락처를 남겨주시면 전문 상담원이 빠르게 연락드립니다.</p>
    <form class="form" data-inquiry="call" novalidate>
      <input type="hidden" name="type" value="call">
      <div class="hp-field" aria-hidden="true"><label>웹사이트<input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
      <div class="form-row">
        <label class="field"><span class="field-label">성명 <em class="req">*</em></span>
          <input type="text" name="name" maxlength="30" autocomplete="name" required></label>
        <label class="field"><span class="field-label">연락처 <em class="req">*</em></span>
          <input type="tel" name="phone" maxlength="20" autocomplete="tel" inputmode="tel" placeholder="010-0000-0000" required></label>
      </div>
      <label class="field"><span class="field-label">이메일</span>
        <input type="email" name="email" maxlength="100" autocomplete="email"></label>
      <label class="field"><span class="field-label">문의 내용 <em class="req">*</em></span>
        <textarea name="content" rows="4" maxlength="2000" placeholder="저장장치 종류, 증상 등을 간단히 적어주세요." required></textarea></label>
<%@ include file="/WEB-INF/jspf/consent.jspf" %>
      <div class="form-msg" role="status" aria-live="polite"></div>
      <button type="submit" class="btn btn-primary btn-block btn-lg">상담 요청하기</button>
    </form>
  </div>
</div>

<div class="modal" id="emailModal" role="dialog" aria-modal="true" aria-labelledby="emailModalTitle" hidden>
  <div class="modal-dialog modal-sm">
    <button type="button" class="modal-close" data-close-modal aria-label="닫기">&times;</button>
    <h2 class="modal-title" id="emailModalTitle">이메일 무단수집거부</h2>
    <p>본 웹사이트에 게시된 이메일 주소가 전자우편 수집 프로그램이나 그 밖의 기술적 장치를 이용하여 무단으로 수집되는 것을 거부합니다. 이를 위반 시 정보통신망법에 의해 형사처벌됨을 유념하시기 바랍니다.</p>
  </div>
</div>

<script src="/resources/js/site.js?v=<%= ASSET_V %>"></script>
